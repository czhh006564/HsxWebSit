# ===== Supabase 配置（在 Supabase 项目 Settings → API 中获取）=====
# 公开地址（前端可见，NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_SUPABASE_URL=
# 公开 anon key（前端可见，仅具备你配置的 RLS 权限）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 服务端 secret key（仅后端使用，切勿暴露到前端 / 提交到仓库）
SUPABASE_SERVICE_ROLE_KEY=

# 说明：
# - 配置以上变量后，预约表单会真实写入 Supabase 的 leads 表。
# - 若留空，API 会降级为"模拟写入"（仅服务端打印日志并返回成功），便于先上线页面。
# - 数据库建表 SQL 见 README.md → 数据库初始化。
